# ===========================================================================
# Forge Agent 环境变量配置
# ===========================================================================
# 复制此文件为 .env 并填入你的实际值：
#   cp .env.template .env
#
# .env 已在 .gitignore 中，不会被提交到远程仓库。
# 启动时通过 python-dotenv 自动加载，无需手动 export。
# ===========================================================================

# ---------------------------------------------------------------------------
# LLM 核心配置（必填）
# ---------------------------------------------------------------------------

# Provider: deepseek / openai / anthropic / groq / ollama / openai-compat
FORGE_LLM_PROVIDER=deepseek

# Model 名称
FORGE_LLM_MODEL=deepseek-v4-flash

# API Base URL
FORGE_LLM_BASE_URL=xxxx

# API Key（通过内部平台获取）
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# ---------------------------------------------------------------------------
# 备用 Provider（按需启用，取消注释并填入 key）
# ---------------------------------------------------------------------------

# OpenAI
# FORGE_LLM_PROVIDER=openai
# FORGE_LLM_MODEL=gpt-4o
# FORGE_LLM_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-xxxx

# Anthropic (Claude)
# FORGE_LLM_PROVIDER=anthropic
# FORGE_LLM_MODEL=claude-sonnet-4-20250514
# ANTHROPIC_API_KEY=sk-ant-xxxx

# Groq（免费高速推理）
# GROQ_API_KEY=gsk_xxxx

# ---------------------------------------------------------------------------
# 模型下载镜像（中国网络必填）
# ---------------------------------------------------------------------------

# HuggingFace 镜像，用于首次下载 embedding 模型（RAG 外部记忆）
HF_ENDPOINT=https://hf-mirror.com

# ---------------------------------------------------------------------------
# Langfuse Observability
# ---------------------------------------------------------------------------

LANGFUSE_PUBLIC_KEY=pk-lf-xxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxx
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_ENVIRONMENT=development
FORGE_PROMPT_SOURCE=local
LANGFUSE_PROMPT_LABEL=production
LANGFUSE_PROMPT_VERSION=
LANGFUSE_PROMPT_NAMESPACE=forge

# ---------------------------------------------------------------------------
# Workbench Multi-Agent（按需调整）
# ---------------------------------------------------------------------------

# 独立于实验性 Agent Team；关闭后不再创建新的 AgentBatch run，历史 run 仍可查看和处置。
GRACE_MULTI_AGENT_MODE_ENABLED=true

# 一个 Multi-Agent DAG 的总 task 上限；每 wave 的 fanout/concurrency 独立受后两项限制。
GRACE_MAX_MULTI_AGENT_TASKS=32
GRACE_MAX_FANOUT_PER_TURN=3
GRACE_MAX_CONCURRENT_SUBAGENTS=4

# Parent workspace 最终验证命令：JSON argv 数组，只以 shell=False 执行管理员配置。
# 示例：[["python","-m","pytest","tests/unit","-q"],["npm.cmd","--prefix","web","run","build"]]
GRACE_MULTI_AGENT_VERIFICATION_COMMANDS=
GRACE_MULTI_AGENT_VERIFICATION_TIMEOUT=300
