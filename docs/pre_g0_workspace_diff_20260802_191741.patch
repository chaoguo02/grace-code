+    registry = SchemaRegistry()
+    outbox = SqliteOutboxStore(db_path, registry)
+    bus = ScopedEventBus()
+
+    # Install outbox DDL
+    import sqlite3
+    conn = sqlite3.connect(db_path)
+    try:
+        SqliteOutboxStore.install(conn)
+        conn.commit()
+    finally:
+        conn.close()
+
+    # Projections
+    trace = TraceProjection(db_path)
+    stats = StatsProjection()
+    ws_gw = WsGateway()
+
