+            try:
+                bus.ensure_session(sid)
+            except Exception:
+                pass  # session already ensured is harmless
+        bus.publish(envelope)
+
+    relay = OutboxRelay(outbox, _deliver)
+    relay.start()
+    logger.info("Native event pipeline started (relay=%s)", relay._worker_id)
+
+    def shutdown():
